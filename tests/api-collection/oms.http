### OMS API requests for the VS Code "REST Client" extension (or the JetBrains HTTP client).
### Generated by scripts/gen-api-collection.mjs from the same catalog as the Postman collection. Do not edit by hand.
### Put the demo password (printed by scripts/run-local.sh) in an environment variable named OMS_DEMO_PASSWORD, or
### in a REST Client environment file; never type it into this file. Run the Auth requests first: they store the tokens.

@baseUrl = http://localhost:18080
@demoPassword = {{$processEnv OMS_DEMO_PASSWORD}}

########## 01 Auth (gateway, profile dev only)

### Login customer1
# @name r1
POST {{baseUrl}}/api/v1/auth/token
Accept: application/json
Content-Type: application/json

{
  "username": "customer1",
  "password": "{{demoPassword}}"
}

@customer1Token = {{r1.response.body.accessToken}}

### Login customer2
# @name r2
POST {{baseUrl}}/api/v1/auth/token
Accept: application/json
Content-Type: application/json

{
  "username": "customer2",
  "password": "{{demoPassword}}"
}

@customer2Token = {{r2.response.body.accessToken}}

### Login operator1
# @name r3
POST {{baseUrl}}/api/v1/auth/token
Accept: application/json
Content-Type: application/json

{
  "username": "operator1",
  "password": "{{demoPassword}}"
}

@operatorToken = {{r3.response.body.accessToken}}

### Login admin1
# @name r4
POST {{baseUrl}}/api/v1/auth/token
Accept: application/json
Content-Type: application/json

{
  "username": "admin1",
  "password": "{{demoPassword}}"
}

@adminToken = {{r4.response.body.accessToken}}

### Login with wrong password -> 401
# @name r5
POST {{baseUrl}}/api/v1/auth/token
Accept: application/json
Content-Type: application/json

{
  "username": "customer1",
  "password": "wrong-password-123"
}

########## 02 Catalog and inventory

### List products (customer)
# @name r6
GET {{baseUrl}}/api/v1/products?size=20
Accept: application/json
Authorization: Bearer {{customer1Token}}

### Get product SKU-1019 (stock 3)
# @name r7
GET {{baseUrl}}/api/v1/products/a0000000-0000-0000-0000-000000001019
Accept: application/json
Authorization: Bearer {{customer1Token}}

### Inventory list (operator)
# @name r8
GET {{baseUrl}}/api/v1/inventory?size=20
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Inventory low stock (operator)
# @name r9
GET {{baseUrl}}/api/v1/inventory?lowStock=true
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Adjust stock +5 SKU-1001 (operator)
# @name r10
PUT {{baseUrl}}/api/v1/inventory/a0000000-0000-0000-0000-000000001001/stock
Accept: application/json
Authorization: Bearer {{operatorToken}}
Content-Type: application/json

{
  "delta": 5,
  "reason": "collection: cycle count"
}

### Stock movements SKU-1001
# @name r11
GET {{baseUrl}}/api/v1/inventory/a0000000-0000-0000-0000-000000001001/movements
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Customer cannot read /inventory -> 403
# @name r12
GET {{baseUrl}}/api/v1/inventory
Accept: application/json
Authorization: Bearer {{customer1Token}}

### Reservations (operator)
# @name r13
GET {{baseUrl}}/api/v1/inventory/reservations?size=10
Accept: application/json
Authorization: Bearer {{operatorToken}}

########## 03 Orders

### Create order (happy path, SKU-1001 x2)
# @name r14
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{customer1Token}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{
  "customerId": "c0000000-0000-0000-0000-000000000001",
  "items": [
    {
      "productId": "a0000000-0000-0000-0000-000000001001",
      "quantity": 2
    }
  ],
  "shippingAddress": {
    "line1": "1 Test Street",
    "city": "Springfield",
    "postalCode": "12345",
    "country": "US"
  }
}

@orderId = {{r14.response.body.id}}

### Replay same key -> 202 + Idempotent-Replay -- Run immediately after the previous request: it reuses the same Idempotency-Key (stored in {{lastIdempotencyKey}}).
# @name r15
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{customer1Token}}
Idempotency-Key: {{r14.request.headers.Idempotency-Key}}
Content-Type: application/json

{
  "customerId": "c0000000-0000-0000-0000-000000000001",
  "items": [
    {
      "productId": "a0000000-0000-0000-0000-000000001001",
      "quantity": 2
    }
  ],
  "shippingAddress": {
    "line1": "1 Test Street",
    "city": "Springfield",
    "postalCode": "12345",
    "country": "US"
  }
}

### Same key, different body -> 422
# @name r16
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{customer1Token}}
Idempotency-Key: {{r14.request.headers.Idempotency-Key}}
Content-Type: application/json

{
  "customerId": "c0000000-0000-0000-0000-000000000001",
  "items": [
    {
      "productId": "a0000000-0000-0000-0000-000000001001",
      "quantity": 3
    }
  ],
  "shippingAddress": {
    "line1": "1 Test Street",
    "city": "Springfield",
    "postalCode": "12345",
    "country": "US"
  }
}

### Missing Idempotency-Key -> 400
# @name r17
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{customer1Token}}
Content-Type: application/json

{
  "customerId": "c0000000-0000-0000-0000-000000000001",
  "items": [
    {
      "productId": "a0000000-0000-0000-0000-000000001001",
      "quantity": 1
    }
  ],
  "shippingAddress": {
    "line1": "1 Test Street",
    "city": "Springfield",
    "postalCode": "12345",
    "country": "US"
  }
}

### Validation error (quantity 0) -> 400
# @name r18
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{customer1Token}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{
  "customerId": "c0000000-0000-0000-0000-000000000001",
  "items": [
    {
      "productId": "a0000000-0000-0000-0000-000000001001",
      "quantity": 0
    }
  ],
  "shippingAddress": {
    "line1": "1 Test Street",
    "city": "Springfield",
    "postalCode": "12345",
    "country": "US"
  }
}

### Insufficient stock SKU-1020 (async REJECTED)
# @name r19
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{customer1Token}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{
  "customerId": "c0000000-0000-0000-0000-000000000001",
  "items": [
    {
      "productId": "a0000000-0000-0000-0000-000000001020",
      "quantity": 1
    }
  ],
  "shippingAddress": {
    "line1": "1 Test Street",
    "city": "Springfield",
    "postalCode": "12345",
    "country": "US"
  }
}

@rejectedOrderId = {{r19.response.body.id}}

### Failed fulfillment (city FAILTOWN)
# @name r20
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{customer1Token}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{
  "customerId": "c0000000-0000-0000-0000-000000000001",
  "items": [
    {
      "productId": "a0000000-0000-0000-0000-000000001004",
      "quantity": 1
    }
  ],
  "shippingAddress": {
    "line1": "1 Test Street",
    "city": "FAILTOWN",
    "postalCode": "12345",
    "country": "US"
  }
}

@failtownOrderId = {{r20.response.body.id}}

### Get order
# @name r21
GET {{baseUrl}}/api/v1/orders/{{orderId}}
Accept: application/json
Authorization: Bearer {{customer1Token}}

### Order status history
# @name r22
GET {{baseUrl}}/api/v1/orders/{{orderId}}/history
Accept: application/json
Authorization: Bearer {{customer1Token}}

### List my orders
# @name r23
GET {{baseUrl}}/api/v1/orders?size=10&sort=createdAt,desc
Accept: application/json
Authorization: Bearer {{customer1Token}}

### Cross-customer read -> 404
# @name r24
GET {{baseUrl}}/api/v1/orders/{{orderId}}
Accept: application/json
Authorization: Bearer {{customer2Token}}

### Cancel order -- 409 INVALID_STATE_TRANSITION when the order already reached a terminal state.
# @name r25
POST {{baseUrl}}/api/v1/orders/{{orderId}}/cancel
Accept: application/json
Authorization: Bearer {{customer1Token}}
Content-Type: application/json

{
  "reason": "collection cancel"
}

### No token -> 401
# @name r26
GET {{baseUrl}}/api/v1/orders
Accept: application/json

########## 04 Fulfillment and notifications

### Fulfillment of order (operator)
# @name r27
GET {{baseUrl}}/api/v1/fulfillments?orderId={{orderId}}
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Customer cannot read fulfillments -> 403
# @name r28
GET {{baseUrl}}/api/v1/fulfillments
Accept: application/json
Authorization: Bearer {{customer1Token}}

### Notifications of order (customer, own only)
# @name r29
GET {{baseUrl}}/api/v1/notifications?orderId={{orderId}}
Accept: application/json
Authorization: Bearer {{customer1Token}}

### Notifications (operator, all)
# @name r30
GET {{baseUrl}}/api/v1/notifications?size=10
Accept: application/json
Authorization: Bearer {{operatorToken}}

########## 05 Operations and admin

### Gateway aggregate health
# @name r31
GET {{baseUrl}}/api/v1/ops/health
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Messaging ops - order
# @name r32
GET {{baseUrl}}/api/v1/ops/order/messaging
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Messaging ops - inventory
# @name r33
GET {{baseUrl}}/api/v1/ops/inventory/messaging
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Messaging ops - fulfillment
# @name r34
GET {{baseUrl}}/api/v1/ops/fulfillment/messaging
Accept: application/json
Authorization: Bearer {{operatorToken}}

### Messaging ops - notification
# @name r35
GET {{baseUrl}}/api/v1/ops/notification/messaging
Accept: application/json
