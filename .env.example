# OMS local Docker Compose environment -- TEMPLATE ONLY, contains NO real secrets.
#
#   cp .env.example .env      # .env is git-ignored
#   then replace EVERY CHANGE_ME value. Suggested generation commands are given per variable.
#   (No openssl? use: node -e "console.log(require('crypto').randomBytes(36).toString('base64'))")
#
# Compose refuses to start when a required value is left empty (":?" checks in docker-compose.yml).
# Values containing '=' or '/' are fine here; they are never put on a command line by the stack.

# ---- JWT signing key (HS256 demo mode); must be >= 32 bytes. `openssl rand -base64 48`
OMS_JWT_SECRET=CHANGE_ME

# ---- password for the demo users customer1/customer2/operator1/admin1 (dev profile token endpoint). `openssl rand -base64 18`
OMS_DEMO_PASSWORD=CHANGE_ME

# ---- PostgreSQL superuser (used only by the init script). `openssl rand -base64 24`
POSTGRES_PASSWORD=CHANGE_ME

# ---- one least-privilege DB role per service (each owns exactly one database). Use URL-safe values:
#      `openssl rand -hex 24`
ORDER_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
FULFILLMENT_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME

# ---- Redis AUTH password. `openssl rand -hex 24`
REDIS_PASSWORD=CHANGE_ME

# ---- Grafana admin password (observability overlay only). `openssl rand -base64 18`
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- non-secret tunables
OMS_VERSION=1.0.0
# Host ports (bound to 127.0.0.1 only)
GATEWAY_HOST_PORT=18080
UI_HOST_PORT=4200
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
