{
  "uid": "oms-hikari",
  "title": "OMS - Hikari Connection Pools",
  "tags": [
    "oms"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=~\"oms-.*\"}, job)",
        "includeAll": true,
        "multi": true,
        "allValue": "oms-.*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=~\"$job\"}",
          "legendFormat": "{{job}} {{pool}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pending threads (waiting for a connection)",
      "description": "Sustained >0 means pool exhaustion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{job=~\"$job\"}",
          "legendFormat": "{{job}} {{pool}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pool utilisation (active / max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=~\"$job\"} / hikaricp_connections_max{job=~\"$job\"}",
          "legendFormat": "{{job}} {{pool}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Idle / total connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_idle{job=~\"$job\"}",
          "legendFormat": "idle {{job}}"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections{job=~\"$job\"}",
          "legendFormat": "total {{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connection acquire time p95 (needs histogram) / mean",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(hikaricp_connections_acquire_seconds_sum{job=~\"$job\"}[5m])) / sum by (job) (rate(hikaricp_connections_acquire_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connection timeouts (per s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(hikaricp_connections_timeout_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connection usage time mean",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(hikaricp_connections_usage_seconds_sum{job=~\"$job\"}[5m])) / sum by (job) (rate(hikaricp_connections_usage_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
