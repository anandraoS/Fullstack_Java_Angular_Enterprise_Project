{
  "name": "oms-ui",
  "version": "1.0.0",
  "description": "Angular UI for the synthetic Enterprise Order Management and Fulfillment Platform (OMS). Synthetic data only.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:coverage": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/build": "20.3.40",
    "@angular/cli": "20.3.40",
    "@angular/compiler-cli": "20.3.34",
    "@eslint/js": "9.39.5",
    "@types/jasmine": "5.1.15",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.5",
    "jasmine-core": "5.9.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
