{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oms.example/schemas/events/InventoryReservationFailed.schema.json",
  "title": "InventoryReservationFailed",
  "description": "Topic oms.inventory.events.v1, produced by inventory-service. schemaVersion 1. Additive changes only (new optional payload fields).",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "aggregateType",
    "aggregateId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "eventType": {
      "const": "InventoryReservationFailed"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregateType": {
      "const": "Order"
    },
    "aggregateId": {
      "type": "string"
    },
    "producer": {
      "const": "inventory-service"
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "INSUFFICIENT_STOCK",
            "UNKNOWN_PRODUCT",
            "PRODUCT_INACTIVE"
          ]
        },
        "shortages": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "requested": {
                "type": "integer",
                "minimum": 0
              },
              "available": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "productId",
              "requested",
              "available"
            ]
          }
        }
      },
      "required": [
        "orderId",
        "reason",
        "shortages"
      ]
    }
  }
}
