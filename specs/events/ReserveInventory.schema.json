{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oms.example/schemas/events/ReserveInventory.schema.json",
  "title": "ReserveInventory",
  "description": "Topic oms.inventory.commands.v1, produced by order-service. schemaVersion 1. Additive changes only (new optional payload fields).",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "aggregateType",
    "aggregateId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "eventType": {
      "const": "ReserveInventory"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregateType": {
      "const": "Order"
    },
    "aggregateId": {
      "type": "string"
    },
    "producer": {
      "const": "order-service"
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "productId",
              "quantity"
            ]
          }
        },
        "reservationTtlSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "orderId",
        "items",
        "reservationTtlSeconds"
      ]
    }
  }
}
