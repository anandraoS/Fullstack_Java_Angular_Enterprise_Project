{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oms.example/schemas/events/InventoryReleased.schema.json",
  "title": "InventoryReleased",
  "description": "Topic oms.inventory.events.v1, produced by inventory-service. schemaVersion 1. Additive changes only (new optional payload fields).",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "aggregateType",
    "aggregateId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "eventType": {
      "const": "InventoryReleased"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregateType": {
      "const": "Order"
    },
    "aggregateId": {
      "type": "string"
    },
    "producer": {
      "const": "inventory-service"
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "CANCELLATION",
            "FULFILLMENT_FAILURE",
            "EXPIRED"
          ]
        }
      },
      "required": [
        "orderId",
        "reservationId",
        "reason"
      ]
    }
  }
}
