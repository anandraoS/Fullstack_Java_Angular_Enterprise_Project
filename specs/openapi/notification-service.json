  "info": {
    "description": "Simulated customer notifications (no real provider is contacted)",
    "title": "OMS notification-service API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/notifications/{id}/retry": {
      "post": {
        "operationId": "retry",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationView"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Retry a FAILED notification: FAILED -> PENDING with a fresh attempt budget (409 otherwise)",
        "tags": [
          "Notifications"
        ]
      }
    },
    "/api/v1/notifications": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "customerId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "orderId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseNotificationView"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List notifications (CUSTOMER: own only, forced filter; OPERATOR/ADMIN: all)",
        "tags": [
          "Notifications"
        ]
      }
    },
