  "info": {
    "description": "Simulated fulfillment lifecycle (PENDING, PICKING, PACKED, SHIPPED, COMPLETED, FAILED)",
    "title": "OMS fulfillment-service API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/fulfillments/{id}/retry": {
      "post": {
        "operationId": "retry",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FulfillmentView"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Retry a FAILED fulfillment: FAILED -> PENDING, attempts reset (409 if not FAILED)",
        "tags": [
          "Fulfillments"
        ]
      }
    },
    "/api/v1/fulfillments": {
