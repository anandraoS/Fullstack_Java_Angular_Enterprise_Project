        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseFulfillmentView"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List fulfillments (OPERATOR, ADMIN)",
        "tags": [
          "Fulfillments"
        ]
