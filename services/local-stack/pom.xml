<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.enterprise.oms</groupId>
    <artifactId>oms-services-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>local-stack</artifactId>
  <name>local-stack</name>
  <description>Docker-free local infrastructure: embedded KRaft Kafka on :19092 with all OMS topics pre-created</description>

  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
    <!-- spring-kafka-test is deliberately compile scope here: it ships the embedded broker (dev tooling only, never deployed). -->
    <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka-test</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <!-- test scope only: drift check that TopicCatalog equals Topics.ALL (no Spring context is started with it) -->
    <dependency><groupId>com.enterprise.oms</groupId><artifactId>platform-common</artifactId><version>${project.version}</version><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.enterprise.oms.localstack.LocalStackApplication</mainClass>
        </configuration>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
